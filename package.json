{
  "name": "nabiz",
  "version": "1.0.0",
  "private": true,
  "description": "Keeps the pulse of long-running work: build tracking, background tasks, notifications",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "files": [
    "extensions",
    "assets",
    "scripts",
    "docs",
    "README.md",
    "README.tr.md",
    "AGENTS.md",
    ".mcp.json"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "workspaces": [
    "packages/*",
    "packages/harness-opencode/plugins/mcp-bash-tools"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace nabiz-core",
    "test:lowmem": "npm run test:lowmem --workspace nabiz-opencode",
    "format": "prettier --write \"packages/*/src/**/*.{ts,mjs,js}\" \"packages/harness-opencode/{plugins,plugin,scripts,tests}/**/*.{ts,mjs}\" \"extensions/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,mjs,js}\" \"packages/harness-opencode/{plugins,plugin,scripts,tests}/**/*.{ts,mjs}\" \"extensions/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint": "oxlint .",
    "typecheck:ext": "node --max-old-space-size=1024 node_modules/typescript/bin/tsc --project tsconfig.extensions.json",
    "check:pi": "node scripts/check-pi-ext.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@types/node": "^20.19.43",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aydemir/nabiz.git"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/hbmon.ts",
      "./extensions/bg-hbmon.ts"
    ]
  }
}
